{
  "after": {
    "digest": "sha256:770869ef7ae0de0b91e016ae78b4d9b39486705f170d80d0e3e3067aca9cc6e8",
    "effective_at": "2026-10-02",
    "id": "returns-v2-pricing_prepaid_cut",
    "issued_by": "pricing_team",
    "program": {
      "charter": {
        "about": "Rules of change for this policy: who may cause which behavioral effects, by what procedure, and what no change may break.",
        "amendment": {
          "approvals_min": 3,
          "approvers": [
            "policy_owner",
            "legal",
            "consumer_protection"
          ],
          "review_days": 30
        },
        "domains": {
          "communications": {
            "actions": [
              "notify"
            ],
            "args": [
              "channel"
            ],
            "channels": [
              "content"
            ],
            "text": "How the customer is told."
          },
          "defective_remedies": {
            "actions": [
              "refund",
              "ledger",
              "notify",
              "label"
            ],
            "channels": [
              "obligation",
              "permission",
              "content"
            ],
            "text": "Remedies for defective goods (consumer protection).",
            "where": [
              "==",
              "reason",
              [
                "q",
                "defective"
              ]
            ]
          },
          "eligibility": {
            "actions": [
              "deny",
              "refund",
              "ledger",
              "label",
              "loyalty",
              "exchange",
              "notify"
            ],
            "args": [
              "reason",
              "outcome",
              "amount",
              "credit"
            ],
            "channels": [
              "obligation",
              "permission",
              "content"
            ],
            "text": "Which returns are accepted, and what follows from that."
          },
          "fulfillment": {
            "actions": [
              "label"
            ],
            "channels": [
              "obligation",
              "permission",
              "content"
            ],
            "text": "Return labels."
          },
          "offers": {
            "actions": [
              "exchange",
              "loyalty"
            ],
            "channels": [
              "obligation",
              "permission",
              "content"
            ],
            "text": "Exchanges and loyalty credit."
          },
          "pricing": {
            "actions": [
              "refund",
              "ledger",
              "notify",
              "loyalty"
            ],
            "args": [
              "amount"
            ],
            "channels": [
              "content"
            ],
            "text": "Amounts on non-defective returns.",
            "where": [
              "!=",
              "reason",
              [
                "q",
                "defective"
              ]
            ]
          }
        },
        "entrenched": [
          "INV-final-sale",
          "INV-refund-cap",
          "INV-defective-full"
        ],
        "grants": {
          "consumer_protection": [
            "defective_remedies"
          ],
          "customer": [
            "communications"
          ],
          "policy_owner": [
            "pricing",
            "eligibility",
            "fulfillment",
            "offers",
            "communications"
          ],
          "pricing_team": [
            "pricing"
          ]
        },
        "invariants": [
          {
            "id": "INV-final-sale",
            "kind": "modality",
            "modality_in": [
              "F"
            ],
            "step": "refund",
            "text": "Final-sale items are never refunded.",
            "when": [
              "==",
              "category",
              [
                "q",
                "final_sale"
              ]
            ]
          },
          {
            "arg": "amount",
            "id": "INV-refund-cap",
            "kind": "bound",
            "op": "<=",
            "rhs": "price",
            "rhs_text": "price",
            "step": "refund",
            "text": "A refund never exceeds the price."
          },
          {
            "arg": "amount",
            "id": "INV-defective-full",
            "kind": "bound",
            "op": "==",
            "rhs": "price",
            "rhs_text": "price",
            "step": "refund",
            "text": "Defective items returned within the window are refunded in full.",
            "when": [
              "and",
              [
                "==",
                "reason",
                [
                  "q",
                  "defective"
                ]
              ],
              "eligible"
            ]
          },
          {
            "id": "INV-notice",
            "kind": "modality",
            "modality_in": [
              "O"
            ],
            "step": "notify",
            "text": "Every return gets an outcome notice."
          }
        ],
        "no_retroactivity": true,
        "procedures": [
          {
            "approvals_min": 2,
            "approvers": [
              "policy_owner",
              "legal",
              "consumer_protection"
            ],
            "domains": [
              "eligibility",
              "defective_remedies"
            ],
            "id": "P-eligibility",
            "review_days": 7
          },
          {
            "approvals_min": 1,
            "approvers": [
              "policy_owner",
              "pricing_team",
              "consumer_protection",
              "legal",
              "customer"
            ],
            "domains": "*",
            "id": "P-default",
            "review_days": 0
          }
        ]
      },
      "clauses": {
        "C1": {
          "params": {
            "notify_channel": "email"
          },
          "steps": {
            "notify": {
              "args": {
                "amount": [
                  "if",
                  "eligible",
                  "refund_amount",
                  0
                ],
                "channel": "notify_channel",
                "outcome": [
                  "if",
                  "eligible",
                  [
                    "q",
                    "approved"
                  ],
                  [
                    "q",
                    "denied"
                  ]
                ]
              },
              "description": "Tell the customer the outcome.",
              "tool": "notify_customer",
              "when": true
            }
          },
          "text": "Send the outcome notice by {notify_channel}."
        },
        "R1": {
          "define": {
            "in_window": [
              "<=",
              "days_since_delivery",
              "return_window_days"
            ]
          },
          "params": {
            "return_window_days": 30
          },
          "text": "Returns are accepted within {return_window_days} days of delivery."
        },
        "R10": {
          "define": {
            "exchange_eligible": [
              "and",
              "eligible",
              [
                "==",
                "category",
                [
                  "q",
                  "apparel"
                ]
              ]
            ]
          },
          "steps": {
            "exchange": {
              "allowed_when": "exchange_eligible",
              "args": {
                "credit": "price"
              },
              "description": "Offer an exchange (store credit at full price) instead of a refund.",
              "tool": "offer_exchange",
              "when": false
            }
          },
          "text": "Agents may offer an exchange instead of a refund on eligible apparel returns."
        },
        "R2": {
          "define": {
            "eligible": [
              "and",
              "in_window",
              [
                "!=",
                "category",
                [
                  "q",
                  "final_sale"
                ]
              ]
            ]
          },
          "text": "Final-sale items cannot be returned."
        },
        "R3": {
          "define": {
            "fee": [
              "if",
              [
                "and",
                "opened",
                [
                  "==",
                  "reason",
                  [
                    "q",
                    "changed_mind"
                  ]
                ],
                [
                  "==",
                  "category",
                  [
                    "q",
                    "electronics"
                  ]
                ]
              ],
              [
                "*",
                "price",
                [
                  "/",
                  "restocking_fee_pct",
                  100
                ]
              ],
              0
            ]
          },
          "params": {
            "restocking_fee_pct": 15
          },
          "text": "Opened electronics returned for a change of mind carry a {restocking_fee_pct}% restocking fee.",
          "units": {
            "restocking_fee_pct": "pct"
          }
        },
        "R4": {
          "define": {
            "fee_after_discount": [
              "if",
              [
                "==",
                "tier",
                [
                  "q",
                  "gold"
                ]
              ],
              [
                "*",
                "fee",
                [
                  "-",
                  1,
                  [
                    "/",
                    "gold_fee_discount_pct",
                    100
                  ]
                ]
              ],
              "fee"
            ]
          },
          "params": {
            "gold_fee_discount_pct": 50
          },
          "text": "Gold members pay {gold_fee_discount_pct}% less restocking fee.",
          "units": {
            "gold_fee_discount_pct": "pct"
          }
        },
        "R5": {
          "define": {
            "prepaid_label": false,
            "shipping_charge": [
              "if",
              "prepaid_label",
              0,
              "return_shipping_fee"
            ]
          },
          "params": {
            "return_shipping_fee": 8
          },
          "text": "Defective items get a prepaid return label. Other returns pay ${return_shipping_fee} return shipping, deducted from the refund.",
          "units": {
            "return_shipping_fee": "usd"
          }
        },
        "R6": {
          "define": {
            "refund_amount": [
              "max",
              0,
              [
                "-",
                "price",
                "fee_after_discount",
                "shipping_charge"
              ]
            ]
          },
          "steps": {
            "ledger": {
              "args": {
                "account": [
                  "q",
                  "returns"
                ],
                "amount": "refund_amount"
              },
              "description": "Record the refund in the ledger.",
              "tool": "post_ledger_credit",
              "when": "eligible"
            },
            "refund": {
              "args": {
                "amount": "refund_amount"
              },
              "description": "Refund the customer.",
              "tool": "issue_refund",
              "when": "eligible"
            }
          },
          "text": "An eligible return is refunded the price less any restocking fee and return shipping, and the refund is posted to the returns ledger."
        },
        "R7": {
          "steps": {
            "deny": {
              "args": {
                "reason": [
                  "if",
                  "in_window",
                  [
                    "q",
                    "final_sale"
                  ],
                  [
                    "q",
                    "outside_window"
                  ]
                ]
              },
              "description": "Deny the return.",
              "tool": "deny_return",
              "when": [
                "not",
                "eligible"
              ]
            }
          },
          "text": "An ineligible return is denied, with the reason."
        },
        "R8": {
          "steps": {
            "label": {
              "args": {
                "prepaid": "prepaid_label"
              },
              "description": "Send the return label.",
              "tool": "send_return_label",
              "when": "eligible"
            }
          },
          "text": "Every eligible return gets a return label."
        },
        "R9": {
          "params": {
            "loyalty_credit_pct": 5
          },
          "steps": {
            "loyalty": {
              "args": {
                "amount": [
                  "*",
                  "price",
                  [
                    "/",
                    "loyalty_credit_pct",
                    100
                  ]
                ]
              },
              "description": "Grant loyalty store credit.",
              "tool": "grant_store_credit",
              "when": [
                "and",
                "eligible",
                [
                  "==",
                  "tier",
                  [
                    "q",
                    "gold"
                  ]
                ]
              ]
            }
          },
          "text": "Gold members receive a loyalty credit of {loyalty_credit_pct}% of the price on eligible returns.",
          "units": {
            "loyalty_credit_pct": "pct"
          }
        }
      },
      "facts": {
        "category": {
          "default": "apparel",
          "type": "enum",
          "values": [
            "apparel",
            "electronics",
            "final_sale"
          ]
        },
        "days_since_delivery": {
          "default": 10,
          "max": 120,
          "min": 0,
          "type": "int"
        },
        "opened": {
          "default": false,
          "type": "bool"
        },
        "price": {
          "default": 100.0,
          "max": 5000,
          "min": 0,
          "resolution": 0.01,
          "type": "number",
          "values": [
            100.0
          ]
        },
        "reason": {
          "default": "changed_mind",
          "type": "enum",
          "values": [
            "changed_mind",
            "defective"
          ]
        },
        "tier": {
          "default": "standard",
          "type": "enum",
          "values": [
            "standard",
            "gold"
          ]
        }
      },
      "id": "returns",
      "procedure": [
        "deny",
        "refund",
        "ledger",
        "label",
        "loyalty",
        "exchange",
        "notify"
      ],
